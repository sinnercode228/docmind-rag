# Copy to .env for docker compose (or backend/.env for local runs). All vars use the DOCMIND_ prefix.

# Tenant API key created on startup (dev/demo convenience). Generate your own!
DOCMIND_BOOTSTRAP_API_KEY=dm_change_me_local_dev_key
# Enables /v1/admin/* (tenant management). Leave empty to disable.
DOCMIND_ADMIN_TOKEN=

# LLM provider: fake (offline, extractive) | anthropic | openai (any OpenAI-compatible server)
DOCMIND_LLM_PROVIDER=fake
DOCMIND_ANTHROPIC_API_KEY=
DOCMIND_ANTHROPIC_MODEL=claude-opus-5
DOCMIND_OPENAI_BASE_URL=http://localhost:11434/v1
DOCMIND_OPENAI_API_KEY=
DOCMIND_OPENAI_MODEL=llama3.1

# Embeddings: hashing (offline, lexical) | openai (OpenAI-compatible /embeddings)
DOCMIND_EMBEDDER=hashing
DOCMIND_EMBEDDING_DIM=384
DOCMIND_EMBEDDING_MODEL=text-embedding-3-small
DOCMIND_EMBEDDING_API_KEY=

# Telegram bot (docker compose --profile telegram up)
DOCMIND_TELEGRAM_BOT_TOKEN=
DOCMIND_TELEGRAM_API_KEY=
